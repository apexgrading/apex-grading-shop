# Database — hosted Postgres via Supabase, in the isolated `apex_shop` schema.
# Get these from your Supabase project → Settings → API.
SUPABASE_URL="https://xkuluggoqxoiqyvbkbaw.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""

# Stripe — get these from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Base URL of the site, used to build Stripe redirect links and image URLs
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Password that unlocks /admin, where new graded cards can be uploaded any time
ADMIN_PASSWORD="change-me"

# Optional — transactional email for order confirmations & newsletter welcomes.
# Without this set, emails are logged to the notifications table but not actually sent.
# Get a key from https://app.brevo.com (SMTP & API → API Keys)
BREVO_API_KEY=""
EMAIL_FROM_NAME="Apex Cards"
EMAIL_FROM_ADDRESS="hello@apexgradingcompany.com"
